        "site_name": { "type": "string", "description": "Site name" },
        "hero_title": { "type": "string", "description": "Hero section title" },
        "hero_tagline": { "type": "string", "description": "Tagline" },
        "hero_description": { "type": "string", "description": "Hero subtext" },
        "about_title": { "type": "string", "description": "About section title" },
        "about_description": { "type": "string", "description": "About summary" },
        "about_bio": { "type": "string", "description": "Detailed bio" },
        "discord": { "type": "string", "description": "Discord handle" },
        "roblox": { "type": "string", "description": "Roblox username" },
        "roblox_profile_url": { "type": "string", "description": "Roblox profile URL" },
        "footer_description": { "type": "string", "description": "Footer copy" },
        "seo_title": { "type": "string", "description": "SEO title" },
        "seo_description": { "type": "string", "description": "SEO description" },
        "available_for_hire": { "type": "boolean", "description": "Commissions open" },
        "admin_password": { "type": "string", "description": "Admin access password" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["site_name"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Commission briefs and contact inquiries submitted by clients",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Client name or studio" },
        "handle": { "type": "string", "description": "Discord or Roblox handle" },
        "service": { "type": "string", "description": "Requested service" },
        "polyBudget": { "type": "string", "description": "Polygon count tier" },
        "timeline": { "type": "string", "description": "Target timeline" },
        "budget": { "type": "string", "description": "Budget in USD or Robux" },
        "description": { "type": "string", "description": "Detailed project brief" },
        "status": { "type": "string", "description": "Status (New, In Review, Completed, Archived)" },
        "created_at": { "type": "string", "description": "Submission ISO timestamp" }
      },
      "required": ["name", "handle", "description"]
    }
  },
  "firestore": {
    "projects": {
      "entity": "Project",
